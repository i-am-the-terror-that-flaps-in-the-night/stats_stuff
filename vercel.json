{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd frontend && npm ci && npm run build",
  "functions": {
    "Backend/app.py": {
      "maxDuration": 60,
      "memory": 1024,
      "excludeFiles": "{frontend/node_modules/**,frontend/src/**,frontend/public/**,frontend/*.ts,frontend/*.json,frontend/*.html,tests/**,scripts/**,.venv/**,.github/**,Data/nhanes_analytic.csv,offline/**,**/*.md,**/*.ipynb,**/__pycache__/**,**/.pytest_cache/**}"
    }
  }
}
